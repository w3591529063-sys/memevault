# 监听端口（默认 3000）
PORT=3000

# 监听地址（Docker 内保持 0.0.0.0）
HOST=0.0.0.0

# 数据目录：SQLite 数据库和所有图片都在这里，请挂载持久化磁盘
DATA_DIR=./data

# 管理密钥：留空则只有上传者能删除自己的表情，管理员不能删评论
# 生成方法：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# 单张图片上限（MB）
MAX_UPLOAD_MB=10

# 单次请求上限（MB），导入包较大时可调高
MAX_BODY_MB=64

# 单次导出上限（MB）
MAX_EXPORT_MB=300

# 部署在 Render / Fly / Nginx 等反向代理后面时设为 1，用于正确识别访客 IP
TRUST_PROXY=1

# 设为 0 可关闭内存限流（不建议）
RATE_LIMIT=1

# 设为 1 打印每个请求
LOG_REQUESTS=0
